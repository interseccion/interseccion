      "type": "interactive",
      "content": "<style>\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n  body { background: #111827; display: flex; align-items: center; justify-content: center; min-height: 100%; padding: 16px; font-family: 'Inter', sans-serif; }\n  .container { width: 100%; max-width: 500px; }\n  .img-wrap { position: relative; border-radius: 10px; overflow: hidden; cursor: crosshair; user-select: none; }\n  img { width: 100%; display: block; }\n  .blur-overlay { position: absolute; inset: 0; backdrop-filter: blur(20px); background: rgba(17,24,39,0.5); transition: opacity 0.8s; }\n  .reveal-circle { position: absolute; border-radius: 50%; width: 120px; height: 120px; border: 2px solid rgba(255,255,255,0.5); pointer-events: none; transform: translate(-50%, -50%); box-shadow: 0 0 0 9999px rgba(17,24,39,0.85); transition: opacity 0.15s; opacity: 0; }\n  .instructions { text-align: center; color: #6b7280; font-size: 12px; margin-top: 10px; }\n</style>\n\n<div class=\"container\">\n  <div class=\"img-wrap\" id=\"wrap\">\n    <!-- Reemplaza la URL con tu imagen -->\n    <img src=\"https://picsum.photos/500/280?grayscale\" alt=\"pista imagen\">\n    <div class=\"blur-overlay\" id=\"overlay\"></div>\n    <div class=\"reveal-circle\" id=\"circle\"></div>\n  </div>\n  <p class=\"instructions\">🔍 Mueve el cursor sobre la imagen para descubrir la pista</p>\n</div>\n\n<script>\nconst wrap = document.getElementById('wrap');\nconst circle = document.getElementById('circle');\nwrap.addEventListener('mousemove', e => {\n  const r = wrap.getBoundingClientRect();\n  const x = e.clientX - r.left, y = e.clientY - r.top;\n  circle.style.left = x + 'px';\n  circle.style.top = y + 'px';\n  circle.style.opacity = '1';\n});\nwrap.addEventListener('mouseleave', () => { circle.style.opacity = '0'; });\n</script>",
